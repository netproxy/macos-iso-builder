# Check if running in interactive mode with piped (no parameters)
if [ $# -eq 0 ]; then
    if [ -p /dev/stdin ] || [ ! -t 0 ]; then
        clear
        log_error "$MSG_PIPED_UNAVAILABLE"
        log_info "Usage: curl -sL <URL> | bash -s <VERSION> [FORMAT] [OUTPUT]"
        echo ""
        log_info "$MSG_EXAMPLE_LABEL curl -sL <URL> | bash -s 26"
        log_info "$MSG_EXAMPLE_LABEL curl -sL <URL> | bash -s 26 dmg"
        log_info "$MSG_EXAMPLE_LABEL curl -sL <URL> | bash -s 26 iso ~/Desktop/Tahoe.iso"
        exit 1
    fi
    run_interactive_menu
fi

# Run main function
main
