show_version_menu() {
    print_header
    echo -e "${BOLD}$MSG_STEP1${NC}"
    print_separator
    echo ""
    
    local i
    i=1
    local col
    col=0
    
    # Print versions in two columns
    echo -e "  ${BOLD}$MSG_COL_HEADER${NC}    ${BOLD}$MSG_COL_HEADER${NC}"
    print_separator
    
    local total
    total=${#MACOS_VERSIONS[@]}
    local half
    half=$(( (total + 1) / 2 ))
    
    for ((i=0; i<half; i++)); do
        # Left column
        IFS='|' read -r ver name year <<< "${MACOS_VERSIONS[$i]}"
        printf "  ${CYAN}%2d${NC})  %-8s  %-16s  %s" "$((i+2))" "$ver" "$name" "$year"
        
        # Right column
        local right_idx
        right_idx=$((i + half))
        if [ $right_idx -lt $total ]; then
            IFS='|' read -r ver name year <<< "${MACOS_VERSIONS[$right_idx]}"
            printf "    ${CYAN}%2d${NC})  %-8s  %-16s  %s" "$((right_idx+2))" "$ver" "$name" "$year"
        fi
        echo ""
    done
    
    echo ""
    print_separator
    echo ""
    echo -e "  ${YELLOW}$MSG_DEFAULT_VER${NC}"
    echo ""
    printf "  $MSG_PROMPT_VER" "$((total+1))"
}

