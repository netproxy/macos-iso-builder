# Helper functions
log_info() {
    echo -e "${GREEN}$(date +'%H:%M:%S') [INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}$(date +'%H:%M:%S') [WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}$(date +'%H:%M:%S') [ERROR]${NC} $1"
}

check_sudo_access() {
    if ! sudo -v; then
        log_error "$MSG_SUDO_REQUIRED"
        exit 1
    fi
    
    # Keep sudo alive
    while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
}

check_disk_space() {
    local required_gb
    required_gb=40
    local threshold_gb
    threshold_gb=15
    local available
    available=$(df -g . | awk 'NR==2 {print $4}')
    
    if [ "$available" -lt "$threshold_gb" ]; then
        log_error "$(printf "$MSG_DISK_CRITICAL" "$available" "$required_gb")"
        log_error "$MSG_DISK_CANNOT_CONTINUE"
        exit 1
    elif [ "$available" -lt "$required_gb" ]; then
        log_error "$(printf "$MSG_DISK_LOW" "$available" "$required_gb")"
        echo ""
        echo -ne "${YELLOW}[WARN]${NC} $MSG_DISK_CONTINUE_PROMPT"
        read -t 10 answer || answer="y"
        case "$answer" in
            [Nn]|[Nn][Oo])
                log_error "$MSG_ABORTED"
                exit 1
                ;;
            *)
                log_info "$MSG_CONTINUING"
                echo ""
                ;;
        esac
    fi
}

detach_disk() {
    local disk
    disk="$1"
    [ -z "$disk" ] && return 0
    
    for attempt in $(seq 1 "$RETRIES_COUNT"); do
        log_info "$(printf "$MSG_DETACH_ATTEMPT" "$attempt" "$RETRIES_COUNT")"
        if sync && sleep 5 && hdiutil detach -quiet "$disk" || hdiutil detach -quiet "$disk" -force; then
            log_info "$MSG_DISK_DETACHED"
            return 0
        fi
        [ "$attempt" -lt "$RETRIES_COUNT" ] && log_warn "$MSG_DETACH_RETRY"
    done
    
    log_error "$(printf "$MSG_DETACH_FAILED" "$disk" "$RETRIES_COUNT")"
    return 1
}

cleanup() {
    # Only clean up if WORK_DIR is defined and not root/home
    if [ -n "$WORK_DIR" ] && [ -d "$WORK_DIR" ] && [ "$WORK_DIR" != "/" ] && [ "$WORK_DIR" != "$HOME" ]; then
        # Unmount
        for mnt in "$WORK_DIR"/*_mnt; do
            [ -d "$mnt" ] && detach_disk "$mnt" 2>/dev/null || true
        done
        
        if [ -n "${DISK_ID:-}" ]; then
            detach_disk "$DISK_ID"
        fi
        
        log_info "$MSG_CLEANUP"
        sudo rm -rf "$WORK_DIR"
    fi
}

