run_interactive_menu() {
    local selected_version
    selected_version=""
    local selected_name
    selected_name=""
    local selected_format
    selected_format=""
    local output_dir
    output_dir=""
    local output_file
    output_file=""
    
    # Step 1: Select macOS version
    while true; do
        show_version_menu
        read -r choice
        
        # Default to Tahoe
        if [ -z "$choice" ]; then
            choice=16
        fi
        
        # Validate input
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 2 ] && [ "$choice" -le $((${#MACOS_VERSIONS[@]} + 1)) ]; then
            local idx
            idx=$((choice - 2))
            IFS='|' read -r selected_version selected_name _ <<< "${MACOS_VERSIONS[$idx]}"
            break
        else
            echo -e "\n  ${RED}$(printf "$MSG_INVALID_VER" "$((${#MACOS_VERSIONS[@]} + 1))")${NC}"
            sleep 2
        fi
    done
    
    # Step 2: Select format
    while true; do
        show_format_menu "$selected_version" "$selected_name"
        read -r choice
        
        # Default to ISO
        if [ -z "$choice" ]; then
            choice=1
        fi
        
        case "$choice" in
            1)
                selected_format="iso"
                break
                ;;
            2)
                selected_format="dmg"
                break
                ;;
            *)
                echo -e "\n  ${RED}$MSG_INVALID_FMT${NC}"
                sleep 2
                ;;
        esac
    done
    
    # Step 3: Select output location
    while true; do
        show_output_menu "$selected_version" "$selected_name" "$selected_format"
        read -r choice
        
        # Default to current directory
        if [ -z "$choice" ]; then
            choice=1
        fi
        
        case "$choice" in
            1)
                output_dir="$(pwd)"
                break
                ;;
            2)
                output_dir="$HOME/Desktop"
                break
                ;;
            3)
                output_dir="$HOME/Downloads"
                break
                ;;
            4)
                output_dir="$HOME"
                break
                ;;
            5)
                echo ""
                echo -n "  $MSG_PROMPT_CUSTOM_PATH"
                read -r custom_path
                # Expand ~ if present
                custom_path="${custom_path/#\~/$HOME}"
                if [ -d "$custom_path" ]; then
                    output_dir="$custom_path"
                    break
                else
                    echo -e "\n  ${RED}$(printf "$MSG_DIR_NOT_EXIST" "$custom_path")${NC}"
                    echo -n "  $MSG_PROMPT_CREATE_DIR"
                    read -r create_dir
                    if [[ "$create_dir" =~ ^[Yy] ]]; then
                        mkdir -p "$custom_path"
                        output_dir="$custom_path"
                        break
                    fi
                fi
                ;;
            *)
                echo -e "\n  ${RED}$MSG_INVALID_OUT${NC}"
                sleep 2
                ;;
        esac
    done
    
    # Format the version name for filename (replace spaces with underscores)
    local filename_name
    filename_name="${selected_name// /_}"
    output_file="${output_dir}/macOS_${filename_name}.${selected_format}"
    
    # Confirmation
    show_confirmation "$selected_version" "$selected_name" "$selected_format" "$output_file"
    read -r confirm
    
    if [[ "$confirm" =~ ^[Nn] ]]; then
        echo ""
        echo -e "  ${YELLOW}$MSG_ABORTED_BY_USER${NC}"
        echo ""
        exit 0
    fi
    
    # Set global variables for main script
    VERSION="$selected_version"
    IMAGE_FORMAT="$selected_format"
    OUTPUT_PATH="$output_file"
    
    clear
}

